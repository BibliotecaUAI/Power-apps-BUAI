ex":12,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"DescarteM.conColDsM.conCodDsM.btnRevisarDs_m.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"DescarteM.conColDsM.conCodDsM.btnRevisarDs_m.OnSelect"}],"properties":{"module":"DescarteM","type":"DescarteM.conColDsM.conCodDsM.btnRevisarDs_m","member":"OnSelect"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":12,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"DescarteM.conColDsM.conGuardarDsM.btnGuardarDs_m.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"DescarteM.conColDsM.conGuardarDsM.btnGuardarDs_m.OnSelect"}],"properties":{"module":"DescarteM","type":"DescarteM.conColDsM.conGuardarDsM.btnGuardarDs_m","member":"OnSelect"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CountRowsGalleryAllItems","ruleIndex":11,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"IngRegistroM.conColRgM.conDonRgM.galDonantesR_m.Visible"}},"logicalLocations":[{"fullyQualifiedName":"IngRegistroM.conColRgM.conDonRgM.galDonantesR_m.Visible"}],"properties":{"module":"IngRegistroM","type":"IngRegistroM.conColRgM.conDonRgM.galDonantesR_m","member":"Visible"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CountRowsGalleryAllItems","ruleIndex":11,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"IngresomaterialM.conColImM.conListaImM.galListaIm.Visible"}},"logicalLocations":[{"fullyQualifiedName":"IngresomaterialM.conColImM.conListaImM.galListaIm.Visible"}],"properties":{"module":"IngresomaterialM","type":"IngresomaterialM.conColImM.conListaImM.galListaIm","member":"Visible"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CountRowsGalleryAllItems","ruleIndex":11,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"IngresomaterialM.conColImM.conListaImM.lblVacioIm.Visible"}},"logicalLocations":[{"fullyQualifiedName":"IngresomaterialM.conColImM.conListaImM.lblVacioIm.Visible"}],"properties":{"module":"IngresomaterialM","type":"IngresomaterialM.conColImM.conListaImM.lblVacioIm","member":"Visible"}}],"properties":{"level":"Medium"}}],"tool":{"driver":{"name":"PowerApps app checker","fullName":"PowerApps app checker","version":"1.349","rules":[{"id":"app-WarnLiteralPredicate","messageStrings":{"issue":{"text":"Warning: This predicate is a literal value and does not reference the input table."}},"properties":{"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"app-SuggestRemoteExecutionHint-OpNotSupportedByService","messageStrings":{"issue":{"text":"Delegation warning. The highlighted part of this formula might not work correctly on large data sets. The \"{0}\" operation is not supported by this connector."}},"properties":{"howToFix":["If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.","Try simplifying the formula.","Try moving your data to a different data source."],"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"app-SuggestRemoteExecutionHint","messageStrings":{"issue":{"text":"Delegation warning. The \"{0}\" part of this formula might not work correctly on large data sets."}},"properties":{"howToFix":["If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.","Try simplifying the formula.","Try moving your data to a different data source."],"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"app-SuggestRemoteExecutionHint-OpNotSupportedByColumn","messageStrings":{"issue":{"text":"Delegation warning. The highlighted part of this formula might not work correctly with column \"{0}\" on large data sets."}},"properties":{"howToFix":["If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.","Try simplifying the formula.","Try moving your data to a different data source."],"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"acc-AccessibleLabelNeeded","messageStrings":{"issue":{"text":"Missing accessible label"}},"properties":{"howToFix":["Edit the accessible label property to describe the item."],"whyFix":"If there's no accessible text, people who can’t see the screen won't understand what’s in images and controls.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-TabIndexShouldBeDefinedForInteractiveControl","messageStrings":{"issue":{"text":"Missing tab stop"}},"properties":{"howToFix":["Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."],"whyFix":"People who use the keyboard with your app will not be able to access this element without a tab stop.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-FocusBorderShouldBeVisible","messageStrings":{"issue":{"text":"Focus isn't showing"}},"properties":{"howToFix":["Change the FocusedBorderThickness property to be more than 0."],"whyFix":"If the focus isn't visible, people who don't use a mouse won't be able to see it when they're interacting with the app.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-ReadableScreenNameNeeded","messageStrings":{"issue":{"text":"Revise screen name"}},"properties":{"howToFix":["Give the screen  a title that describes what's on the screen or what it's used for."],"whyFix":"People who are blind, have low vision, or a reading disability rely on screen titles to navigate using the screen reader. ","level":"Low","componentType":"app","primaryCategory":"accessibility"}},{"id":"app-UnusedMediaResources","messageStrings":{"issue":{"text":"Archivos multimedia sin usar"}},"properties":{"howToFix":["Quite el archivo multimedia que no se use en el panel Medios."],"whyFix":"No hay ninguna fórmula de control que haga referencia a este archivo multimedia, por lo que no es necesario. Si se quita, mejorará el rendimiento.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CollectDelegatableDataSource","messageStrings":{"issue":{"text":"Es posible que las filas recuperadas del origen de datos no estén completas."}},"properties":{"howToFix":["Limite los datos recopilados del origen de datos actualizando la fórmula \"ClearCollect(colFicha; tblFichaDescarte)\" para incluir una función de filtrado, como \"Filter\" o \"Search\"."],"whyFix":"Si el origen de datos es demasiado grande, es posible que el uso de la función \"Collect\" para crear una colección directamente a partir de un origen de datos conectado no cargue todas las filas.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CollectingReadOnlyTable","messageStrings":{"issue":{"text":"La colección está inicializada, pero nunca actualizada"}},"properties":{"howToFix":["Reemplace Collect o ClearCollect por una fórmula con nombre en App.Formulas. Por ejemplo, MyTable = Filter(origen, condición). Las fórmulas con nombre se calculan cuando sus entradas cambian y no conllevan el costo de seguimiento de una colección."],"whyFix":"Las colecciones están diseñadas para actualizarse. Power Apps realiza un trabajo adicional para realizar un seguimiento de cada colección de modo que todo lo que dependa de ella permanezca sincronizado cuando cambien los datos. Cuando los datos nunca cambian después de establecerlos, se desperdicia el trabajo de seguimiento. Una fórmula con nombre proporciona los mismos datos sin el costo adicional.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CountRowsGalleryAllItems","messageStrings":{"issue":{"text":"Usar AllItemsCount en lugar de CountRows con AllItems"}},"properties":{"howToFix":["Reemplace CountRows(Gallery.AllItems) por Gallery.AllItemsCount para mejorar el rendimiento."],"whyFix":"El uso de CountRows con la propiedad AllItems de una galería fuerza la creación de una tabla de salida que contiene una copia del origen de datos de entrada y el estado actual de todos los controles secundarios. Esto puede forzar la inicialización de filas no inicializadas, consumiendo ciclos de CPU adicionales, memoria y potencialmente desencadenando solicitudes de red de nivel de fila.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-ForAllWithMutation","messageStrings":{"issue":{"text":"La mutación de una colección o un origen de datos dentro de ForAll puede desencadenar una reevaluación excesiva de la regla"}},"properties":{"howToFix":["Dado que ForAll devuelve una tabla, pase su resultado como entrada a la función de mutación en una llamada por lotes única. Por ejemplo, reemplace ForAll(source, Collect(c, { ... })) por Collect(c, ForAll(source, { ... })); el mismo patrón se aplica a Patch y Remove. Una mutación por lotes única emite una notificación de cambio en lugar de una por iteración.","En el caso de las actualizaciones o eliminaciones triviales por fila con un origen de datos, se prefieren las funciones UpdateIf o RemoveIf delegables a las que se llama una vez fuera de ForAll en lugar de iterar con ForAll."],"whyFix":"El uso de Collect, Patch, Remove u otra función de mutación dentro del cuerpo de ForAll muta la colección de destino o el origen de datos una vez por iteración. Cada propiedad de control que depende de esa colección u origen de datos se vuelve a evaluar en cada mutación, lo que puede convertir un pequeño bucle en miles de evaluaciones de reglas y, para los orígenes de datos conectados, una solicitud de red por fila.","componentType":"app","primaryCategory":"performance","level":"Medium"}}]}},"invocations":[{"executionSuccessful":true}],"columnKind":"utf16CodeUnits"}]}